# CRA inlines REACT_APP_* at build time — rebuild/redeploy after changes.
#
# Dokploy (frontend service):
#   Build context: frontend/
#   Dockerfile: Dockerfile
#   Build arg / env: REACT_APP_API_URL=https://your-backend.example.com
#
# Local Docker: REACT_APP_API_URL=... docker compose up -d --build
# Local npm start: put this file in frontend/ and restart.

# Production API origin (backend), no trailing slash
REACT_APP_API_URL=https://your-backend.example.com

# Local dev — override in .env if needed:
# REACT_APP_API_URL=http://localhost:5000
# REACT_APP_API_URL=proxy

# Optional — only if features are used
REACT_APP_PIXABAY_API_KEY=
REACT_APP_FIREBASE_API_KEY=
REACT_APP_BASE_URL=
REACT_APP_API_ENDPOINT=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_DATABASE_URL=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=
REACT_APP_GOOGLE_MAP_KEY=
REACT_APP_AUTH0_DOMAIN=
REACT_APP_AUTH0_CLIENT_ID=
