# Inventory frontend (CRA) — deploy as its own Dokploy service
# Context: frontend/
# Port: 80
#
# Build-time env (CRA inlines REACT_APP_*):
#   Dokploy → Build Arguments:
#     REACT_APP_API_URL=https://your-backend.example.com

FROM node:24-alpine AS build

WORKDIR /app

RUN apk add --no-cache python3 make g++

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Passed from Dokploy as Docker build args
ARG REACT_APP_API_URL=
ARG REACT_APP_BASE_URL=
ARG REACT_APP_API_ENDPOINT=
ARG REACT_APP_PIXABAY_API_KEY=
ARG REACT_APP_FIREBASE_API_KEY=
ARG REACT_APP_FIREBASE_AUTH_DOMAIN=
ARG REACT_APP_FIREBASE_DATABASE_URL=
ARG REACT_APP_FIREBASE_PROJECT_ID=
ARG REACT_APP_FIREBASE_STORAGE_BUCKET=
ARG REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
ARG REACT_APP_FIREBASE_APP_ID=
ARG REACT_APP_FIREBASE_MEASUREMENT_ID=
ARG REACT_APP_GOOGLE_MAP_KEY=
ARG REACT_APP_AUTH0_DOMAIN=
ARG REACT_APP_AUTH0_CLIENT_ID=

ENV REACT_APP_API_URL=$REACT_APP_API_URL \
    REACT_APP_BASE_URL=$REACT_APP_BASE_URL \
    REACT_APP_API_ENDPOINT=$REACT_APP_API_ENDPOINT \
    REACT_APP_PIXABAY_API_KEY=$REACT_APP_PIXABAY_API_KEY \
    REACT_APP_FIREBASE_API_KEY=$REACT_APP_FIREBASE_API_KEY \
    REACT_APP_FIREBASE_AUTH_DOMAIN=$REACT_APP_FIREBASE_AUTH_DOMAIN \
    REACT_APP_FIREBASE_DATABASE_URL=$REACT_APP_FIREBASE_DATABASE_URL \
    REACT_APP_FIREBASE_PROJECT_ID=$REACT_APP_FIREBASE_PROJECT_ID \
    REACT_APP_FIREBASE_STORAGE_BUCKET=$REACT_APP_FIREBASE_STORAGE_BUCKET \
    REACT_APP_FIREBASE_MESSAGING_SENDER_ID=$REACT_APP_FIREBASE_MESSAGING_SENDER_ID \
    REACT_APP_FIREBASE_APP_ID=$REACT_APP_FIREBASE_APP_ID \
    REACT_APP_FIREBASE_MEASUREMENT_ID=$REACT_APP_FIREBASE_MEASUREMENT_ID \
    REACT_APP_GOOGLE_MAP_KEY=$REACT_APP_GOOGLE_MAP_KEY \
    REACT_APP_AUTH0_DOMAIN=$REACT_APP_AUTH0_DOMAIN \
    REACT_APP_AUTH0_CLIENT_ID=$REACT_APP_AUTH0_CLIENT_ID \
    GENERATE_SOURCEMAP=false \
    NODE_OPTIONS=--openssl-legacy-provider \
    CI=true

RUN npm run build

FROM nginx:1.27-alpine AS production

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
