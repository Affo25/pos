# Dokploy → Backend service → Environment
# Do not bake secrets into the image; set these on the platform.

NODE_ENV=production
PORT=5000

MONGO_URI=mongodb+srv://user:pass@cluster/POS?retryWrites=true&w=majority
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE=7d

# Public URL of the frontend (CORS + email links)
FRONTEND_URL=https://your-frontend.example.com

# Email — smtp | resend | brevo | outlook
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RESEND_API_KEY=
RESEND_FROM=
APP_NAME=Inventory Management

# WhatsApp (optional)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_MESSAGE_MODE=text
